# ==== Multi-Administrador - Variables de entorno (Docker Compose) ====

# PostgreSQL
POSTGRES_USER=multiadmin
POSTGRES_PASSWORD=multiadmin
POSTGRES_DB=multiadmin_db

# Clave secreta para firmar JWT (cámbiala en producción)
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# Orígenes permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (se usa en el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# URL de la API que consume el frontend (build arg)
VITE_API_URL=http://localhost:8000

# ---- SMTP (para recuperación de contraseña real) ----
# Ejemplo con Gmail: MAIL_SERVER=smtp.gmail.com  EMAIL_USER=tu@gmail.com
# Necesitas una "contraseña de aplicación" (no la normal).
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=

# ---- Chatbot ----
# local = motor con datos de la BD (sin API externa). llm = modelo OpenAI (requiere API key).
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging SQL
SQL_ECHO=false
